{
  "name": "fer-07-project",
  "version": "1.0.0",
  "description": "Interactive pizzeria menu, cart and table-booking application",
  "engines": {
    "node": ">=20.19"
  },
  "main": "index.html",
  "scripts": {
    "test": "npm run test:html && npm run test:js && npm run test:scss",
    "test:html": "html-validate src/*.html",
    "test:js": "eslint src/js/",
    "test:scss": "stylelint src/sass/",
    "build": "npm run build:clean && npm run build:copy && npm run build:sass && npm run build:autoprefixer && npm test",
    "build:clean": "node scripts/clean.mjs",
    "build:copy": "node scripts/copy.mjs",
    "build:sass": "sass --style=compressed --no-source-map src/sass:dist/css",
    "build:autoprefixer": "postcss dist/css/*.css --use autoprefixer -d dist/css",
    "build-dev": "npm run build-dev:sass && npm run build:autoprefixer",
    "build-dev:sass": "sass --style=expanded --source-map src/sass:dist/css",
    "server": "json-server --port 3131 --no-cors --delay 250 --watch dist/db/app.json",
    "watch": "npm-run-all build build-dev -p watch:* server",
    "watch:browsersync": "browser-sync start --server dist --files \"dist/**/*\" --ignore \"dist/db/**/*\"",
    "watch:sassprefixer": "onchange \"src/sass/**/*.scss\" -- npm run build-dev",
    "watch:copy": "onchange -e \"**/sass/**/*\" -e \"**/.gitkeep\" \"src/**/*\" -- npm run build:copy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "autoprefixer": "^10.2.4",
    "@eslint/js": "^9.0.0",
    "browser-sync": "^3.0.4",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "html-validate": "^7.3.2",
    "npm-run-all": "^4.1.5",
    "onchange": "^7.1.0",
    "postcss": "^8.2.6",
    "postcss-cli": "^8.3.1",
    "postcss-scss": "^4.0.4",
    "sass": "^1.80.0",
    "stylelint": "^14.11.0",
    "stylelint-config-standard-scss": "^5.0.0",
    "stylelint-scss": "^4.3.0"
  },
  "dependencies": {
    "json-server": "^0.17.3"
  },
  "overrides": {
    "immutable": "^4.3.9"
  }
}
